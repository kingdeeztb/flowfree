<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 顶部信息区域 -->
            <TextView
                android:id="@+id/topview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textSize="14sp"
                android:text="Author:iPanStone@酷安\nDate:2025-05-20 18:00:00" />

            <!-- 开关 -->
            <Switch
                android:id="@+id/openswitchclnc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:checked="true"
                android:text="是/否显示CLNC工作目录" />

            <!-- 按钮区域 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/buttonOpenClnc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:text="开启CLNC" />

                <Button
                    android:id="@+id/buttonCloseClnc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:text="关闭CLNC" />

                <Button
                    android:id="@+id/buttonCleanTencentQQ"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:text="清理QQ后台" />

                <Button
                    android:id="@+id/buttonAlipayTrip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:text="打开支付宝出行" />

                <Button
                    android:id="@+id/buttonAlipaycode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:text="打开支付宝付款码" />
            </GridLayout>

            <!-- 日志显示区域 -->
            <TextView
                android:id="@+id/logview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:text="等待命令执行结果..."
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>